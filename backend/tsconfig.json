{
  "compilerOptions": {
    // File layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Output
    "sourceMap": true,

    // Stricter type checking
    "strict": true,
    "noUncheckedIndexedAccess": true,

    // Recommended
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src"]
}